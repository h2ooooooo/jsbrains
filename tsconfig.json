{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "baseUrl": ".",
      "paths": {
         "@/*": ["packages/jsbrains/src/*"],
         "@cli/*": ["packages/jsbrains-cli/src/*"],
         "@jalsoedesign/jsbrains": ["packages/jsbrains/src/index.ts"]
      },
      "types": ["node"]
   },
   "include": ["packages/*/src", "packages/*/tests", "packages/*/examples", "packages/*/*.config.ts", "scripts", "*.config.ts"]
}
