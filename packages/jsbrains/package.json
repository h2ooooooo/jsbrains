{
    "name": "@jalsoedesign/jsbrains",
    "version": "1.0.0-rc.1",
    "description": "Read JetBrains IDE installations, projects, settings, deployments and credentials from Node.js.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "docs/COMPATIBILITY.md",
        "THIRD-PARTY-NOTICES.txt",
        "LICENSE",
        "KDBX-SOURCE.json"
    ],
    "engines": {
        "node": ">=20"
    },
    "license": "MIT",
    "keywords": [
        "jetbrains",
        "phpstorm",
        "webstorm",
        "deployment",
        "keepass"
    ],
    "scripts": {
        "build": "node ../../scripts/generate-kdbx-runtime.mjs && tsup && node ../../scripts/check-kdbx-bundle.mjs",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.8.15",
        "fast-xml-parser": "^5.12.0",
        "hash-wasm": "^4.12.0"
    },
    "devDependencies": {
        "kdbxweb": "2.1.1"
    },
    "publishConfig": {
        "access": "public",
        "tag": "rc"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h2ooooooo/jsbrains.git",
        "directory": "packages/jsbrains"
    },
    "homepage": "https://h2ooooooo.github.io/jsbrains/",
    "bugs": {
        "url": "https://github.com/h2ooooooo/jsbrains/issues"
    }
}
